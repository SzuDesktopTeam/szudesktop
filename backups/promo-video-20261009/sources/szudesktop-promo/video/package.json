{
  "name": "szudesktop-promo-video",
  "version": "0.1.0",
  "private": true,
  "description": "szuDesktop · 荔枝庭院 宣传片（Remotion 工程）",
  "license": "UNLICENSED",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "sprites:demo": "node scripts/extract-demo-sprites.mjs",
    "demo": "node scripts/render.mjs --comp ComponentDemo --out ../work/remotion-check/component-demo.mp4",
    "stills": "node scripts/render-stills.mjs",
    "render:16x9": "node scripts/render.mjs --comp Main16x9 --out ../out/szudesktop-promo-16x9.mp4 --props '{\"music\":\"assets/audio/promo_16x9_full.wav\"}'",
    "render:9x16": "node scripts/render.mjs --comp Main9x16 --out ../out/szudesktop-promo-9x16.mp4 --props '{\"music\":\"assets/audio/promo_9x16_full.wav\"}'"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/layout-utils": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "puppeteer-core": "25.12.0",
    "typescript": "5.9.3"
  }
}
